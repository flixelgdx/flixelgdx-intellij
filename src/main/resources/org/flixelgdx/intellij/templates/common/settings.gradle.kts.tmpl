pluginManagement {
{{- if compositeBuild}}
  // Builds the FlixelGDX Gradle plugins from your local clone of the framework.
  includeBuild("{{frameworkPath | kotlin}}")
{{- end}}
  repositories {
{{- if mavenLocal}}
    // Uses the framework you published with ./gradlew publishToMavenLocal first.
    mavenLocal()
{{- end}}
    gradlePluginPortal()
    google()
    mavenCentral()
  }
}

plugins {
  // Downloads the Java version the build asks for when it is not installed yet.
  id("org.gradle.toolchains.foojay-resolver-convention") version "1.0.0"
  // Reads project.toml, includes the modules you chose and sets the group and version.
  id("org.flixelgdx.project") version "{{frameworkVersion}}"
}

dependencyResolutionManagement {
  repositoriesMode = RepositoriesMode.FAIL_ON_PROJECT_REPOS
  repositories {
{{- if mavenLocal}}
    mavenLocal()
{{- end}}
    mavenCentral()
    google()
  }
}

rootProject.name = "{{folder | kotlin}}"
{{- if compositeBuild}}

// Builds the framework from your local clone, so your changes to it show up without publishing.
includeBuild("{{frameworkPath | kotlin}}")
{{- end}}
