{{if kotlin -}}
import org.jetbrains.kotlin.gradle.dsl.JvmTarget

{{end -}}
plugins {
  // The Gradle plugins this module needs. Add a line here when a library asks for one.
  id("com.android.application")
{{- if kotlin}}
  id("org.jetbrains.kotlin.android")
{{- end}}
}

android {
  namespace = "{{package}}.backend"
  compileSdk = 36

  defaultConfig {
    // These three come from project.toml, so change them there.
    applicationId = game.packageName
    minSdk = 26
    targetSdk = 35
    versionCode = game.build
    versionName = game.version
    multiDexEnabled = true
  }

  compileOptions {
    // The game is written for Java 25. Android's own tools turn the newer language features
    // into ones every supported phone understands.
    isCoreLibraryDesugaringEnabled = true
    sourceCompatibility = JavaVersion.VERSION_25
    targetCompatibility = JavaVersion.VERSION_25
  }

  sourceSets {
    named("main") {
      // The same assets folder the desktop and web builds use.
      assets.srcDir(rootProject.file("assets"))
    }
  }
}

java {
  toolchain {
    languageVersion.set(JavaLanguageVersion.of(25))
    vendor.set(JvmVendorSpec.ADOPTIUM)
  }
}
{{- if kotlin}}

kotlin {
  compilerOptions {
    jvmTarget = JvmTarget.JVM_25
  }
}
{{- end}}

dependencies {
  coreLibraryDesugaring(libs.bundles.androidDesugar)
  implementation(project(":core"))
  implementation(libs.bundles.android)
{{- if not kotlin}}
  annotationProcessor(libs.bundles.androidProcessors)
{{- end}}
}
{{- if kotlin}}

// Kotlin runs annotation processors through kapt, which a package can apply to this module.
plugins.withId("org.jetbrains.kotlin.kapt") {
  dependencies {
    "kapt"(libs.bundles.androidProcessors)
  }
}
{{- end}}
