<idea-plugin>
  <id>org.flixelgdx.ide</id>
  <name>FlixelGDX</name>
  <vendor url="https://github.com/flixelgdx">FlixelGDX</vendor>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends>org.jetbrains.plugins.gradle</depends>
  <depends>org.jetbrains.plugins.textmate</depends>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="FlixelGDX" displayType="BALLOON"/>
    <applicationConfigurable
        parentId="tools"
        id="org.flixelgdx.intellij.settings"
        instance="org.flixelgdx.intellij.settings.FlxgdxConfigurable"
        displayName="FlixelGDX"/>
    <projectConfigurable
        parentId="org.flixelgdx.intellij.settings"
        id="org.flixelgdx.intellij.settings.project"
        instance="org.flixelgdx.intellij.settings.FlxgdxProjectConfigurable"
        displayName="Project"
        nonDefaultProject="true"/>
    <newProjectWizard.generator implementation="org.flixelgdx.intellij.wizard.FlxgdxNewProjectWizard"/>
    <postStartupActivity implementation="org.flixelgdx.intellij.startup.FlxgdxStartupActivity"/>
    <toolWindow
        id="FlixelGDX"
        anchor="bottom"
        canCloseContents="false"
        icon="AllIcons.Toolwindows.ToolWindowBuild"
        factoryClass="org.flixelgdx.intellij.doctor.DoctorToolWindowFactory"/>
    <localInspection
        language="UAST"
        shortName="FlixelGdxAllocation"
        displayName="Allocation in per-frame code"
        groupName="FlixelGDX"
        enabledByDefault="true"
        level="WEAK WARNING"
        implementationClass="org.flixelgdx.intellij.inspections.FlixelAllocationInspection"/>
    <localInspection
        language="UAST"
        shortName="FlixelGdxCollection"
        displayName="Standard Java collection"
        groupName="FlixelGDX"
        enabledByDefault="true"
        level="WEAK WARNING"
        implementationClass="org.flixelgdx.intellij.inspections.FlixelCollectionInspection"/>
    <localInspection
        language="UAST"
        shortName="FlixelGdxReflection"
        displayName="Reflection"
        groupName="FlixelGDX"
        enabledByDefault="true"
        level="WARNING"
        implementationClass="org.flixelgdx.intellij.inspections.FlixelReflectionInspection"/>
    <localInspection
        language="UAST"
        shortName="FlixelGdxUnsupportedApi"
        displayName="API missing on Android or the web"
        groupName="FlixelGDX"
        enabledByDefault="true"
        level="WARNING"
        implementationClass="org.flixelgdx.intellij.inspections.FlixelUnsupportedApiInspection"/>
    <textmate.bundleProvider implementation="org.flixelgdx.intellij.wgsl.WgslBundleProvider"/>
    <internalFileTemplate name="WGSL Shader"/>
  </extensions>

  <actions>
    <action id="org.flixelgdx.intellij.NewWgslShader"
            class="org.flixelgdx.intellij.wgsl.NewWgslShaderAction">
      <add-to-group group-id="NewGroup" anchor="last"/>
    </action>

    <group
        id="org.flixelgdx.intellij.FlixelGdxGroup"
        class="org.flixelgdx.intellij.actions.FlxgdxActionGroup"
        text="FlixelGDX"
        popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>

      <action id="org.flixelgdx.intellij.AddLibrary"
              class="org.flixelgdx.intellij.actions.AddLibraryAction"
              text="Add Library..."
              description="Add a library to the FlixelGDX project with flxgdx"/>
      <action id="org.flixelgdx.intellij.AddPlugin"
              class="org.flixelgdx.intellij.actions.AddPluginAction"
              text="Add Plugin..."
              description="Add a Gradle plugin to the FlixelGDX project with flxgdx"/>
      <action id="org.flixelgdx.intellij.RemovePackage"
              class="org.flixelgdx.intellij.actions.RemovePackageAction"
              text="Remove Library or Plugin..."
              description="Remove an installed library or plugin with flxgdx"/>
      <separator/>
      <action id="org.flixelgdx.intellij.AddPlatform"
              class="org.flixelgdx.intellij.actions.AddPlatformAction"
              text="Add Platform..."
              description="Add a platform (desktop, web or Android) to the project"/>
      <action id="org.flixelgdx.intellij.RemovePlatform"
              class="org.flixelgdx.intellij.actions.RemovePlatformAction"
              text="Remove Platform..."
              description="Remove a platform from the project"/>
      <separator/>
      <action id="org.flixelgdx.intellij.InstallHandbook"
              class="org.flixelgdx.intellij.actions.InstallHandbookAction"
              text="Install Handbook..."
              description="Copy the documentation of a repository into the handbooks folder"/>
      <action id="org.flixelgdx.intellij.UninstallHandbook"
              class="org.flixelgdx.intellij.actions.UninstallHandbookAction"
              text="Uninstall Handbook..."
              description="Remove a handbook that was installed with flxgdx"/>
      <separator/>
      <action id="org.flixelgdx.intellij.Upgrade"
              class="org.flixelgdx.intellij.actions.UpgradeAction"
              text="Upgrade..."
              description="Upgrade the installed packages to their latest release"/>
      <action id="org.flixelgdx.intellij.RunDoctor"
              class="org.flixelgdx.intellij.doctor.RunDoctorAction"
              text="Run Doctor"
              description="Check that this computer and the project are ready to build"/>
    </group>
  </actions>
</idea-plugin>
